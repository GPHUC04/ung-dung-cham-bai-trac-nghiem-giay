# ============================================================
# Ứng dụng Chấm bài Trắc nghiệm — Cấu hình môi trường Backend
# ============================================================
# SAO CHÉP file này thành .env và điền giá trị thật vào

# --- PostgreSQL / Supabase ---
# Lấy từ: Supabase Dashboard > Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Supabase API ---
# Lấy từ: Supabase Dashboard > Settings > API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Tên bucket lưu ảnh phiếu trả lời và hình câu hỏi
SUPABASE_BUCKET_PHIEU=phieu-tra-loi
SUPABASE_BUCKET_CAUHOIANH=cau-hoi-hinh-anh

# --- JWT Authentication ---
# Tạo bằng: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_256BIT_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- App Settings ---
APP_NAME=Hệ thống Chấm bài Trắc nghiệm
APP_VERSION=1.0.0
DEBUG=True

# --- CORS (danh sách URL được phép gọi API) ---
# Thêm URL của React Admin và Flutter khi deploy
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
